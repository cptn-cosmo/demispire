{
  "manifest_version": 3,
  "name": "Demispire",
  "version": "0.2.0",
  "description": "Rolls your Daggerheart dice from Demiplane character sheets in TaleSpire, with Hope and Fear dice and the outcome announced in chat.",
  "homepage_url": "https://github.com/cptn-cosmo/demispire",
  "browser_specific_settings": {
    "gecko": {
      "id": "demispire@cptn-cosmo",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://app.demiplane.com/*"],
  "content_scripts": [
    {
      "matches": ["https://app.demiplane.com/*"],
      "js": ["src/parse.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Demispire",
    "default_popup": "popup/popup.html"
  }
}
